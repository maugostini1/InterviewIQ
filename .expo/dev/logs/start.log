{"_e":"metro:client_log","_t":1786110913515,"level":"error","data":["\n\n\u001b[1mCode: feedback.tsx\u001b[22m\n\u001b[0m \u001b[90m 195 |\u001b[39m       ) \u001b[33m:\u001b[39m (\n \u001b[90m 196 |\u001b[39m         improvementAnswers\u001b[33m.\u001b[39mmap((answer) \u001b[33m=>\u001b[39m (\n\u001b[31m\u001b[1m>\u001b[22m\u001b[39m\u001b[90m 197 |\u001b[39m           \u001b[33m<\u001b[39m\u001b[33mImprovementAnswerCard\u001b[39m\n \u001b[90m     |\u001b[39m           \u001b[31m\u001b[1m^\u001b[22m\u001b[39m\n \u001b[90m 198 |\u001b[39m             key\u001b[33m=\u001b[39m{answer\u001b[33m.\u001b[39mquestion_id}\n \u001b[90m 199 |\u001b[39m             answer\u001b[33m=\u001b[39m{answer}\n \u001b[90m 200 |\u001b[39m           \u001b[33m/\u001b[39m\u001b[33m>\u001b[39m\u001b[0m\n\u001b[1mCall Stack\u001b[22m\n\u001b[90m  improvementAnswers.map$argument_0 (src\\app\\feedback.tsx:197:11)\u001b[39m\n\u001b[90m  FeedbackScreen (src\\app\\feedback.tsx:196:31)\u001b[39m\n\u001b[90m  RootLayout (src\\app\\_layout.tsx:5:5)\u001b[39m"]}
