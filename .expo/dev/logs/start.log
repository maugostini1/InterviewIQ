{"_e":"metro:client_log","_t":1786237942005,"level":"log","data":["History response body:","{\"total_interviews\":8,\"average_score\":18.5,\"interviews\":[{\"session_id\":8,\"target_job\":\"Software Engineer\",\"session_start_time\":\"2026-08-03 13:29:55\",\"session_end_time\":\"2026-08-03 13:34:10\",\"score\":2.6,\"status\":\"completed\"},{\"session_id\":9,\"target_job\":\"Software Engineer\",\"session_start_time\":\"2026-08-03 13:36:00\",\"session_end_time\":\"2026-08-03 13:37:09\",\"score\":5.0,\"status\":\"completed\"},{\"session_id\":20,\"target_job\":\"Software Engineer\",\"session_start_time\":\"2026-08-03 13:46:01\",\"session_end_time\":\"2026-08-03 13:47:13\",\"score\":5.0,\"status\":\"completed\"},{\"session_id\":23,\"target_job\":\"Software Engineer\",\"session_start_time\":\"2026-08-07 13:28:57\",\"session_end_time\":\"2026-08-07 13:33:37\",\"score\":28.2,\"status\":\"completed\"},{\"session_id\":26,\"target_job\":\"Software Engineer\",\"session_start_time\":\"2026-08-07 13:49:32\",\"session_end_time\":\"2026-08-07 13:51:23\",\"score\":43.8,\"status\":\"completed\"},{\"session_id\":25,\"target_job\":\"Software Engineer\",\"session_start_time\":\"2026-08-07 13:46:11\",\"session_end_time\":\"2026-08-07 13:55:45\",\"score\":19.92,\"status\":\"completed\"},{\"session_id\":284,\"target_job\":\"ML Engineer\",\"session_start_time\":\"2026-08-08 00:05:01\",\"session_end_time\":\"2026-08-08 00:07:22\",\"score\":16.0,\"status\":\"completed\"},{\"session_id\":297,\"target_job\":\"ML Engineer\",\"session_start_time\":\"2026-08-09 01:05:27\",\"session_end_time\":\"2026-08-09 01:06:47\",\"score\":27.2,\"status\":\"completed\"}]}"]}
